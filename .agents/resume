#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# No services or authentication are required. Check the persisted login-shell
# environment without downloading dependencies or rebuilding on every wake.
exec bash -lc '
  if [[ "${MDEX_NATIVE_BUILD:-}" != 1 ]] || ! command -v mix > /dev/null || ! command -v cargo > /dev/null; then
    echo "Orb toolchain is missing; run .agents/setup to repair it." >&2
    exit 1
  fi
'
